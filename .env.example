# Copy to .env to override the compose defaults. Placeholder values only.
POSTGRES_USER=gymscout
POSTGRES_PASSWORD=change-me
# Zone used for "today" (visits, weekly volume, cost per visit).
GYMSCOUT_ZONE=Africa/Cairo
# Seed the invented Cairo gyms on first start.
GYMSCOUT_DEMO_DATA=true
# synthetic (offline, default) | overpass (live OpenStreetMap data, be gentle)
GYMSCOUT_PLACES_SOURCE=synthetic
# straight-line (offline, default) | osrm (public OSRM demo server)
GYMSCOUT_ROUTING_SOURCE=straight-line
# Port of the web UI on the host.
WEB_PORT=8091
